# HAL config file for vismach simulation of a vertical milling machine
# This file only handles axis movement. 

loadrt [KINS]KINEMATICS
# motion controller, get name and thread periods from ini file
loadrt [EMCMOT]EMCMOT base_period_nsec=[EMCMOT]BASE_PERIOD servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS num_dio=20 num_aio=64
loadrt timedelay names=spindle-on-delay
loadrt and2 names=a_low-psi,near-and,test-and
loadrt near names=near_speed,near-x,near-y
loadrt or2 names=amber-or-red
loadrt and2 names=amber-light-and
loadrt not names=blue-light-not
loadrt mux4 names=blue-light-mux
loadrt mux16 names=amber-light-mux
loadrt mux8 names=green-light-mux
loadrt mux16 names=white-light-mux
loadrt mux4 names=red-light-mux
loadrt abs names=abs_white,abs_amber,abs_blue,abs_red
loadrt lut5 names=any_light_lut


loadrt edge names=machine-reset
loadrt flipflop names=fault-latch

addf machine-reset servo-thread
addf fault-latch servo-thread
addf amber-or-red servo-thread
# Add LUT5 to the servo thread
addf any_light_lut servo-thread

# Configure LUT5 to perform a binary OR operation
# Any light active (white, amber, blue, red) => output is TRUE
setp any_light_lut.function 0b00000001

loadusr comp/arduino-connector

addf amber-light-and servo-thread
addf blue-light-not servo-thread


addf spindle-on-delay servo-thread
addf blue-light-mux servo-thread
addf amber-light-mux servo-thread
addf white-light-mux servo-thread
addf red-light-mux servo-thread
addf abs_white servo-thread
addf abs_amber servo-thread
addf abs_blue servo-thread
addf abs_red servo-thread
addf green-light-mux servo-thread

####

addf near_speed servo-thread
addf near-x servo-thread
addf near-y servo-thread
addf a_low-psi servo-thread
addf near-and servo-thread
addf test-and servo-thread
addf motion-command-handler servo-thread
addf motion-controller servo-thread

setp a_low-psi.in1 1

setp near-x.scale 1
setp near-x.difference 2
setp near-y.scale 1
setp near-y.difference 2
setp near-x.in2 58.5
#setp near-y.in2 5.75
#net test  motion.digital-out-02 test-and.in0

# loop position commands back to motion module feedback

net x-pos joint.0.motor-pos-cmd => joint.0.motor-pos-fb near-x.in1
net y-pos joint.1.motor-pos-cmd => joint.1.motor-pos-fb near-y.in1
net z-pos joint.2.motor-pos-cmd => joint.2.motor-pos-fb

net x-pos-lim joint.0.pos-lim-sw-in joint.0.home-sw-in
net x-neg-lim joint.0.neg-lim-sw-in
net y-pos-lim joint.1.pos-lim-sw-in joint.1.home-sw-in
net y-neg-lim joint.1.neg-lim-sw-in 
net z-pos-lim joint.2.pos-lim-sw-in joint.2.home-sw-in
net z-neg-lim joint.2.neg-lim-sw-in

# estop loopback
net estop-loop iocontrol.0.user-enable-out iocontrol.0.emc-enable-in

net flood iocontrol.0.coolant-flood
net mist iocontrol.0.coolant-mist

net tlo motion.analog-in-30 <= halui.tool.length_offset.z

#loadrt lut5 names=lut5.manualatctoggle,lut5.servoalarm,lut5.estop,lut5.drawbar_open,lut5.manualmode,lut5.andor
loadrt toggle names=toogle_manualatc
loadrt not names=n_timer,n_servoenable,n_atctoggle,n_watchdog,n_coneclean,n_key0,n_key1,n_key2,n_key3,n_key4,n_key5,n_key6,n_key7,n_key8,n_key9,n_key10,n_drawbar_open,n_air-psi
loadrt conv_s32_bit names=u32bit.tool
addf u32bit.tool servo-thread
loadrt spindle_interlock names=s_interlock
addf n_timer servo-thread
addf n_air-psi servo-thread
addf s_interlock servo-thread

net optional_stop_status motion.digital-in-01 <= halui.program.optional-stop.is-on
net toolnumber iocontrol.0.tool-number => u32bit.tool.in
