# *** Rack ATC Offset ***

setp y-atc-offset.in0 [AXIS_Y]MAX_LIMIT_ADJUSTED
net y-max-limit-addition motion.analog-out-00 => y-atc-offset.in1
net y-max-limit-adjusted y-atc-offset.out => ini.y.max_limit

# reset to default
# M68 E00 Q0.0
# add extra travel on top of [AXIS_Y]MAX_LIMIT
# M68 E00 Q#<_ini[AXIS_Y]MAX_LIMIT_ADDITIONAL> 

# *** End Rack ATC Offset ***

# Probe_screen_v2 with vers.by probe
# The next two lines are only needed if the pins had been connected before
#unlinkp iocontrol.0.tool-change
#unlinkp iocontrol.0.tool-changed

# link to auto tool measurement toolchange, so you get the advantage of tool description on change dialog
# these settings were moved to probe_screen.hal:
#net tool-change            probe.toolchange-change    <=   iocontrol.0.tool-change 
#net tool-changed           probe.toolchange-changed   <=   iocontrol.0.tool-changed
#net tool-prep-number       probe.toolchange-number    <=   iocontrol.0.tool-prep-number

net tool-change-request     =>  qtpyvcp_manualtoolchange.change
net tool-change-confirmed   <=  qtpyvcp_manualtoolchange.changed
net tool-number             =>  qtpyvcp_manualtoolchange.number
	
#net tool-prep-loop         iocontrol.0.tool-prepare      <=   iocontrol.0.tool-prepared

setp spindle-on-delay.on-delay 0
setp spindle-on-delay.off-delay 5
net spindle-is-on-interlock spindle.0.on => spindle-on-delay.in
net spindle-is-on-delayed spindle-on-delay.out => s_interlock.encoder-counts

net spindle-max_rpm  s_interlock.limit halui.tool.length_offset.u

net draw-bar motion.digital-out-00 =>   qtpyvcp.drawbar-led.on
net low-psi-net motion.digital-in-00 => a_low-psi.out
net low-psi-net n_air-psi.in
setp qtpyvcp.air-psi-led.flash-rate 250

net low-psi-net_n  n_air-psi.out => qtpyvcp.air-psi-led.flash
net low-psi-net_n  n_air-psi.out => qtpyvcp.air-psi-led.on
net low-psi-net_n  n_air-psi.out => amber-light-mux.sel2

net machine-is-on amber-light-mux.sel3
net machine-is-on halui.machine.is-on

net case-air motion.digital-out-01 =>   qtpyvcp.case-air-led.on

setp halui.program.block-delete.off 1
setp halui.program.block-delete.on 0

#loadrt lut5

# Add lut5 to the thread
#addf lut5.0 servo-thread

# Set the truth table for (input1 OR input2) AND input3
# Binary representation for each input combination, where 1 is True
#setp lut5.0.function 0xE0

# Connect inputs
#net input1 <= your_signal_1
#net input2 <= your_signal_2
#net input3 <= your_signal_3

# Connect the LUT output to the desired signal
#net output_signal <= lut5.0.out

net is-auto	<= halui.mode.is-auto		=> blue-light-enable.sel 
net is-paused	<= halui.program.is-paused	=> amber-light-mux.sel0

net amber-light-paused	 amber-light-mux.sel1	<= motion.digital-out-02

setp green-light-mux.in5 1
setp green-light-mux.in7 2

setp amber-light-mux.in08 0
setp amber-light-mux.in09 1
setp amber-light-mux.in10 0
setp amber-light-mux.in11 2
setp amber-light-mux.in12 2
setp amber-light-mux.in13 2
setp amber-light-mux.in14 2
setp amber-light-mux.in15 2

net red-light status_light.red		<= motion.analog-out-01 
net amber-light status_light.amber	<= amber-light-mux.out-f

net green-light status_light.green	<= green-light-mux.out

net blue-light status_light.blue	<= blue-light-enable.out	
net blue-light-in blue-light-enable.in1	<= motion.analog-out-04 

net machine-is-on white-light-mux.sel
net white-light-statue	white-light-mux.in1	motion.analog-out-05


net white-light status_light.white	<= white-light-mux.out 

net buzzer-light status_light.buzzer	<= motion.analog-out-06 
net test-light status_light.test	<= motion.analog-out-07

net auto-touch-off-net	qtpyvcp.enable-auto-touchoff.checked  motion.digital-in-02

# Connect existing nets to abs inputs
net white-light => abs_white.in
net amber-light => abs_amber.in
net blue-light => abs_blue.in
net red-light => abs_red.in

# Boolean outputs indicating if each light is active (analog > 0)
net white-light-active abs_white.is-positive
net amber-light-active abs_amber.is-positive
net blue-light-active abs_blue.is-positive
net red-light-active abs_red.is-positive

# Connect abs outputs to LUT5 inputs
net white-light-active => any_light_lut.in-0
net amber-light-active => any_light_lut.in-1
net blue-light-active => any_light_lut.in-2
net red-light-active => any_light_lut.in-3

# Control Green Light Logic
# Green light should only be active when no higher-priority lights are active

net green-light-any-other green-light-mux.sel2 <= any_light_lut.out
net program-running halui.program.is-running => green-light-mux.sel1
net machine-is-on green-light-mux.sel0

#####


loadrt logic count=1 personality=0x206  # 6 inputs with OR output
addf logic.0 servo-thread               # Add it to the servo thread

# Connect your signals to the inputs
net sig1 => logic.0.in-00
net sig2 => logic.0.in-01
net sig3 => logic.0.in-02
net sig4 => logic.0.in-03
net sig5 => logic.0.in-04
net sig6 => logic.0.in-05

# Connect the OR output to your desired signal
net or_output <= logic.0.or
