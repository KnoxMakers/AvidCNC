#*** Begin #INCLUDE file: layout2.inc
[XHC_HB04_BUTTONS]
# use button names according to layout file LIB:xhc-hb04-layout{n}.cfg
# note: "start-pause" is connected for standard behavior
#        controlling halui.pause/halui.resume/halui.run
# these are examples, edit as required:

goto-zero   = halui.mdi-command-00
# synthesized per-axis buttons for goto-zero button:
goto-zero-x = ""
goto-zero-y = ""
goto-zero-z = ""
goto-zero-a = ""

start-pause = std_start_pause
rewind      = halui.program.step
# probe-input for simulating a probe:
probe-z     = halui.mdi-command-02
#macro-3     = halui.mdi-command-03

#half        = halui.spindle.0.stop
half        = ""
# synthesized per-axis buttons for half button:
half-x      = halui.mdi-command-04
half-y      = halui.mdi-command-05
half-z      = ""
half-a      = ""

zero        = ""
# synthesized per-axis buttons for zero button:
zero-x      = halui.mdi-command-12
zero-y      = halui.mdi-command-13
zero-z      = halui.mdi-command-14
zero-a      = halui.mdi-command-15

safe-z      = halui.mdi-command-10
# in this sim, home-all only works first time, hold down till finished:
home        = halui.mdi-command-07
macro-1     = halui.mdi-command-08
#macro-2     = halui.mdi-command-02
#spindle     = halui.spindle.0.start
spindle     = halui.mdi-command-01
step        = xhc-hb04.stepsize-up
#mode        = toggle_mod
#macro-6     = halui.mdi-command-06
#macro-7     = halui.mdi-command-07
stop        = halui.program.stop
reset       = halui.estop.activate

[HALUI]
# these are examples, edit as required:
# a halui hal pin is created for each MDI_COMMAND below
# halui.mdi-command-00, halui.mdi-command-01,... etc
MDI_COMMAND=O<go_to_zero> CALL
MDI_COMMAND=O<go_to_g30> CALL
MDI_COMMAND=O<probe_z_minus_wco> CALL
#03 M110: clears notifications
MDI_COMMAND=M110
MDI_COMMAND=G10 L20 P0 X[#<_x>/2.0]
MDI_COMMAND=G10 L20 P0 Y[#<_y>/2.0]
MDI_COMMAND=(debug, example: mdi-06)
#07 M101: example print to stdout
MDI_COMMAND=O<go_to_home> CALL
MDI_COMMAND=O<boundaries-scan> CALL
MDI_COMMAND=(debug, example: mdi-09)
MDI_COMMAND=G0 G53 Z0
MDI_COMMAND=(debug, example: mdi-11)
#12
MDI_COMMAND= G10 L20 P0 X0
#13
MDI_COMMAND= G10 L20 P0 Y0
#14
MDI_COMMAND= G10 L20 P0 Z0
#15
MDI_COMMAND= G10 L20 P0 C0
#*** End   #INCLUDE file: layout2.inc
 
[EMC] 
MACHINE = avidcnc-basic
DEBUG = 0
VERSION = 1.1
 
[VTK] 
MACHINE_PARTS = machine.yml
 
[DISPLAY] 
USER_TABS_PATH = user_tabs/
USER_BUTTONS_PATH = user_buttons/
DISPLAY = probe_basic
CONFIG_FILE = custom_config.yml
FULLSCREEN = True
POSITION_OFFSET = RELATIVE
POSITION_FEEDBACK = COMMANDED
MAX_FEED_OVERRIDE = 2.000000
MAX_SPINDLE_OVERRIDE = 1.000000
MIN_SPINDLE_OVERRIDE = 0.500000
INTRO_GRAPHIC = linuxcnc.gif
INTRO_TIME = 1
OPEN_FILE = ~/linuxcnc/nc_files/blank.ngc
CONFIRM_EXIT = False
PROGRAM_PREFIX = ~/linuxcnc/nc_files/USERS
INCREMENTS = JOG .1in .01in .001in .0005in
POSITION_FEEDBACK = COMMANDED
DEFAULT_LINEAR_VELOCITY = 5.000000
MAX_LINEAR_VELOCITY = 23.5
#MAX_LINEAR_VELOCITY = 4
MIN_LINEAR_VELOCITY = 0.016667
DEFAULT_ANGULAR_VELOCITY = 12.000000
MAX_ANGULAR_VELOCITY = 180.000000
MIN_ANGULAR_VELOCITY = 1.666667
EDITOR = gedit
GEOMETRY = xyz
PIN = 1337
KEYBOARD_JOG = true
KEYBOARD_JOG_SAFETY_OFF = true
NAV = 1
 
[XHC_HB04_CONFIG] 
# specify layout = n for LIB:xhc-hb04-layout{n}.cfg files
layout = 2
# coords: specify upto 4 letters from set {x y z a b c u v w}
# coords: switch labels are xyza but any unique 4 letters
# from the set {xyxabcuvw) can be used (if the coord exists)
coords = x y z
# lowpass settings:
# coef: slows rate of change of output,  range: 0 < coef < 1
coefs = 1 1 1 1
# scale plus or minus, rotaries may require larger scale factor:
scales = 1 1 1 1
# jogmode normal(default) or vnormal
jogmode = vnormal
# sequence 1: 0.001,0.010,0.100,1.000 (mm-based machine)
# sequence 2: 0.001,0.005,0.010,0.020 (inch-based machine)
# sequence 3: 0.001,0.010,0.100
# sequence 4: 0.001,0.005,0.010,0.020,0.050,0.100
# sequence 5: 0.001,0.010,0.050,0.100,1.000
sequence = 3
# require_pendant = yes|no: create xhc-hb04 hal pins when pendant not
# connected at startup
require_pendant = no
# inch_or_mm = in | mm
inch_or_mm = in
# mpg_accels: provision for reduced acceleration for manual mode jogging
mpg_accels = 100 300 3000
 
[APPLICATIONS] 
APP = monitor-xhc-hb04
 
[MACROS] 
MACRO = go_to_fixture_1.ngc,Fixture 1
MACRO = boundaries-scan.ngc,Bounding Box
 
[FILTER] 
PROGRAM_EXTENSION = .png,.gif,.jpg Greyscale Depth Image
PROGRAM_EXTENSION = .py Python Script
png = image-to-gcode
gif = image-to-gcode
jpg = image-to-gcode
py = python
 
[PYTHON] 
TOPLEVEL = ./python/toplevel.py
PATH_APPEND = ./python/
PATH_APPEND = ./python/python-stdglue/
 
[TASK] 
TASK = milltask
CYCLE_TIME = 0.010
 
[RS274NGC] 
PARAMETER_FILE = linuxcnc.var
RS274NGC_STARTUP_CODE = F10 S300 G20 G17 G40 G49 G54 G64 P0.001 G80 G90 G91.1 G92.1 G94 G97 G98
FEATURES = 30
PROGRAM_PREFIX = ~/linuxcnc/nc_files/USERS
SUBROUTINE_PATH = ./atc_rack:./subroutines
REMAP=M6 modalgroup=6 prolog=change_prolog ngc=toolchange epilog=change_epilog
REMAP=M10 modalgroup=6 argspec=P ngc=m10
REMAP=M11 modalgroup=6 argspec=PT ngc=m11
REMAP=M12 modalgroup=6 ngc=m12
REMAP=M13 modalgroup=6 ngc=m13
REMAP=M14 modalgroup=6 ngc=m14
REMAP=M0 modalgroup=4 ngc=m0
REMAP=M1 modalgroup=4 ngc=m1
REMAP=M38 modalgroup=6 ngc=tool_touch_off
REMAP=M300 modalgroup=6 ngc=m300
REMAP=M301 modalgroup=6 python=m301
#REMAP=M8 modalgroup=8 ngc=m8
#REMAP=M9 modalgroup=8 ngc=m9
USER_M_PATH = ./
 
[EMCMOT] 
EMCMOT = motmod
COMM_TIMEOUT = 1.0
SERVO_PERIOD = 1000000
 
[HMOT] 
# **** This is for info only ****
CARD0=hm2_7i76e.0 
 
[HAL] 
HALUI = halui
HALFILE = avidcnc-basic.hal
HALFILE = LIB:xhc-hb04.tcl
HALFILE = atc.hal
POSTGUI_HALFILE = probe_basic_postgui.hal
SHUTDOWN = shutdown.hal
TWOPASS = on
 
[KINS] 
JOINTS = 4
KINEMATICS = trivkins coordinates=XYYZ kinstype=BOTH
 
[TRAJ] 
AXES = 3
COORDINATES =  XYYZ
LINEAR_UNITS = inch
ANGULAR_UNITS = degree
DEFAULT_LINEAR_VELOCITY = 1.67
MAX_LINEAR_VELOCITY = 23.5
 
[EMCIO] 
EMCIO = io
CYCLE_TIME = 0.100
TOOL_TABLE = tool.tbl
 
