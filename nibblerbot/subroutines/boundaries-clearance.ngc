O<boundaries-clearance> SUB

(-------------------------------------------------------------------------------------------------------)
#<_UseInches> =           1     ( set to 1 to use inches here, or 0 to use millimeters )
#<_TravelFeed> =     500     ( feedrate used to travel to and along the boundaries )
(-------------------------------------------------------------------------------------------------------)

M70                   ( save current modal state )
G[21 - #<_UseInches>] ( use inches or millimeters as required here, units will be restored on return )
(#G30.1)                 ( save current position in #5181-#5183... )
G90                   ( use absolute positioning here )
G40                   ( turn cutter radius compensation off here )
G94                   ( use feedrate in units/min )
G61                   ( follow exact path, don't round corners )

#1 = #<_hal[qtpyvcp.xmin]>
#2 = #<_hal[qtpyvcp.xmax]>
#3 = #<_hal[qtpyvcp.ymin]>
#4 = #<_hal[qtpyvcp.ymax]>

( Move to first corner of bounding box )
G53 G0 X[#1 -3.5] Y[#3 - 6.878]
( Drive around the block )
G53 G1 F#<_TravelFeed> X[#1 - 3.5] Y[#4 + 3.5]
G53 G1 F#<_TravelFeed> X[#2 + 3.5] Y[#4 + 3.5]
G53 G1 F#<_TravelFeed> X[#2 + 3.5] Y[#3 - 6.878]
G53 G1 F#<_TravelFeed> X[#1 - 3.5] Y[#3 - 6.878]

M68 E6 Q1
G4  P.3 ; Pause for a tad to let the limit change happen
M68 E6 Q0

(#G53 G0 X[#5181] Y[#5182])  ( return to where we were in X Y)
M72                       ( restore modal state )

O<boundaries-clearance> ENDSUB
M2
